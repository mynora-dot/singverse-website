---
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import '../styles/site.css'
interface Props { title: string; description: string; noIndex?: boolean }
const { title, description, noIndex = false } = Astro.props
---
<!doctype html>
<html lang="zh-CN" data-pagefind-ignore={noIndex ? 'all' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noIndex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/assets/brand/favicon.ico" />
    <link rel="apple-touch-icon" href="/assets/brand/icon-192.png" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <header class="site-header"><SiteHeader /></header>
    <slot />
    <SiteFooter />
  </body>
</html>
