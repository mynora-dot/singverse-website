{
  "name": "@singverse/website",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 5174",
    "build": "node scripts/deployment-assets.mjs && astro build --force && node scripts/legacy-routes.mjs && node scripts/security-headers.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check:content": "node scripts/content.mjs",
    "check": "npm run test:compose && astro check && npm run build && npm run check:content",
    "check:http": "node scripts/http-check.mjs",
    "check:dependencies": "npm audit --audit-level=high",
    "check:release": "python3 -m unittest discover -s infra/docker/tests -v",
    "test:compose": "node --test scripts/compose.test.mjs",
    "check:compose": "node scripts/check-compose.mjs",
    "check:deployment-sources": "node scripts/check-deployment-sources.mjs",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/markdown-remark": "7.3.9",
    "@astrojs/starlight": "0.43.1",
    "astro": "7.4.12",
    "typescript": "6.0.3"
  }
}
